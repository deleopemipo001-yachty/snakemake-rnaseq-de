# Main entry point for the workflow.
configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/sra.smk"
include: "rules/qc.smk"
include: "rules/ref.smk"
include: "rules/align.smk"
include: "rules/count.smk"
include: "rules/deseq2.smk"


# Build the requested MultiQC report from all configured samples.
rule all:
    default_target: True
    input:
        "results/multiqc/multiqc_report.html",
        "results/counts/counts.txt",
        "results/counts/counts_matrix.tsv",
        "results/qc/chrom_names.txt",
        "results/deseq2/all_genes.tsv",
        "results/deseq2/degs.tsv",
        "results/deseq2/summary.tsv",
        "results/deseq2/dds.rds",
        "results/deseq2/vst.rds",
        "results/deseq2/session_info.txt",
        expand(
            "results/figures/{name}.{extension}",
            name=[
                "pca",
                "pca_patient_adjusted",
                "sample_distances",
                "ma_plot",
                "volcano",
                "heatmap_top50",
            ],
            extension=["png", "pdf"],
        ),
